# Template only. Never copy real credentials into this tracked file.
# Docker Compose requires both values to be non-empty.
MYSQL_ROOT_PASSWORD=
APP_JWT_SECRET=

# Historical backend: export these explicitly before starting it.
# Spring Boot does not load Docker Compose .env files automatically.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
